# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smart_recruiter
# DB_USER=postgres
# DB_PASSWORD=your-postgres-password
# DB_HOST=localhost
# DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_NAME=smart_recruiter
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
